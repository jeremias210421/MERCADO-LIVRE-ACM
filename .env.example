# Bipador ACM - Environment Variables
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=your-super-secret-key-at-least-32-chars-long
FLASK_ENV=development
FLASK_DEBUG=1

# Supabase (obrigatório)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alternativas (use apenas uma):
# SUPABASE_SECRET_KEY=
# SUPABASE_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Opcional: Desabilitar rate limiting em desenvolvimento
DISABLE_RATE_LIMIT=0

# Opcional: Configurações de logging
LOG_LEVEL=INFO